generator client {
  provider = "prisma-client" // no "*-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER  @map("user")
  ADMIN @map("admin")
  DEV   @map("dev")
}

